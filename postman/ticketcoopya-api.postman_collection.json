{
  "info": {
    "_postman_id": "ec73a1bd-7d1c-4c01-8f83-48f174219b20",
    "name": "Tickets Coopya API - Prueba rápida",
    "description": "Colección mínima para comprobar el backend de Tickets Coopya.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://TU-DOMINIO-DE-RAILWAY.up.railway.app"
    },
    {
      "key": "ticketId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Listar tickets",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/tickets/"
      }
    },
    {
      "name": "Crear ticket de prueba",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "pm.collectionVariables.set('ticketId', response.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "titulo",
              "value": "Prueba desde Postman",
              "type": "text"
            },
            {
              "key": "descripcion",
              "value": "Ticket creado para comprobar la conexión con Railway.",
              "type": "text"
            },
            {
              "key": "correo",
              "value": "pruebas@coopya.com",
              "type": "text"
            },
            {
              "key": "prioridad",
              "value": "media",
              "type": "text"
            },
            {
              "key": "asignar",
              "value": "Facundo Bernard",
              "type": "text"
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/tickets/"
      }
    },
    {
      "name": "Actualizar ticket creado",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estado\": \"en_progreso\",\n  \"prioridad\": \"alta\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/tickets/{{ticketId}}"
      }
    }
  ]
}
